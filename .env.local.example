# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the client. Needed for super admin invites and test seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used in auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Integration tests (optional)
RUN_INTEGRATION_TESTS=false
TEST_PASSWORD=choose-a-test-password
